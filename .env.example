# Environment Configuration Template
# Copy this file to .env and replace ALL placeholder values before running.

# Database Configuration
POSTGRES_USER=ims_user
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_random_password
POSTGRES_DB=ims_db
DATABASE_URL=postgresql://ims_user:CHANGE_ME_use_a_strong_random_password@postgres:5432/ims_db

# Security & API Secrets
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_python_secrets_token_hex_64
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PASSWORD_SALT=CHANGE_ME_GENERATE_WITH_python_secrets_token_hex_32

# Environment: "development" or "production"
# Production mode enforces: PostgreSQL required, real SECRET_KEY required, header overrides disabled.
ENVIRONMENT=development

REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,http://localhost,http://127.0.0.1
TRUSTED_PROXY_IPS=127.0.0.1
ORGANIZATION_ID=default
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
BACKUP_ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_STRONG_BACKUP_KEY
BACKUP_S3_URI=s3://CHANGE_ME-ims-backups/production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=af-south-1

# Production TLS must terminate at a trusted load balancer/reverse proxy.
# Only port 80 is exposed by the local Compose stack; do not expose it directly to the Internet.
