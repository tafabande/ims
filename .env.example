# Environment Configuration Example
# Copy this file to .env and set actual production environment variables on your server.

# Database Configuration
POSTGRES_USER=ims_user
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=ims_db
DATABASE_URL=postgresql://ims_user:your_secure_db_password_here@postgres:5432/ims_db

# Security & API Secrets
SECRET_KEY=your_jwt_secret_key_here
ENVIRONMENT=production
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost,http://127.0.0.1
